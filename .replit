modules = ["go-1.21", "java-graalvm22.3", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
run = ["bash", "start-production.sh"]
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./dmg-web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-bc6407a2-065d-4e9e-80a9-9033692599b0"
