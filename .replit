modules = ["go-1.21", "java-graalvm22.3", "nodejs-20", "go-1.25"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
run = ["bash", "-c", "set -e; cd frontend; bun run build; cd ..; GOTOOLCHAIN=local go build -o dmg-web .; exec ./dmg-web"]
deploymentTarget = "vm"
build = ["bash", "-c", "cd frontend && bun run build && cd .. && GOTOOLCHAIN=local go build -o dmg-web ."]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./dmg-web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
